# ---------- Supabase (PostgreSQL + pgvector) ----------
# Session pooler (IPv4) — Supabase > Connect > Session pooler
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Rol de solo lectura usado por el servidor MCP (creado por database/load_database.py)
MCP_DB_PASSWORD=<genera-una-contraseña>
MCP_DATABASE_URL=postgresql://mcp_readonly.<project_ref>:<MCP_DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---------- Google Gemini ----------
GEMINI_API_KEY=<tu-api-key-de-aistudio.google.com>
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---------- Servidor MCP ----------
MCP_AUTH_TOKEN=<token-largo-aleatorio>

# ---------- n8n / EC2 ----------
N8N_VERSION=latest
N8N_DOMAIN=n8n.<IP-con-guiones>.sslip.io
MCP_DOMAIN=mcp.<IP-con-guiones>.sslip.io
N8N_DB_PASSWORD=<contraseña>
N8N_ENCRYPTION_KEY=<clave-aleatoria-32-caracteres>
APP_API_KEY=<clave-que-usa-la-app-movil>

# ---------- Google Sheets (calendario) ----------
# Archivo > Compartir > Publicar en la web > CSV
CALENDAR_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/<id>/pub?output=csv
