{
  "info": {
    "name": "UNABot · webhooks n8n y servidor MCP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de los webhooks de n8n (las mismas llamadas que hace la app Android) y del servidor MCP. Define las variables api_key (APP_API_KEY) y mcp_token (MCP_AUTH_TOKEN) en el entorno; nunca las guardes en la colección."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://n8n.35-168-41-252.sslip.io/webhook"
    },
    {
      "key": "mcp_url",
      "value": "https://mcp.35-168-41-252.sslip.io"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "mcp_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Webhooks n8n",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Valida código y PIN contra Supabase (función verificar_pin).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"U00100002\",\n  \"pin\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/app/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "app",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
