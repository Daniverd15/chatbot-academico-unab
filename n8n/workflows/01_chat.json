      "parameters": {
        "jsCode": "const n = $('Normalizar').first().json;\nreturn [{ json: { respuesta: 'No puedo ayudarte con esa solicitud. Soy el asistente académico de Ingeniería de Sistemas UNAB: pregúntame por tu matrícula, tu avance, fechas, competencias digitales o normas del programa.',\n  intencion: 'bloqueado_guardrail', bloqueado: true, flags: ['entrada'], codigo: n.codigo, session_id: n.session_id } }];"
      },
