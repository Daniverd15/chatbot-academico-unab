    {
      "parameters": {
        "jsCode": "const j = $input.first().json ?? {};\nconst n = $('Normalizar').first().json;\nlet r = j.respuesta ?? j.output ?? j.text ?? '';\nif (!r || j.error) r = 'Tuve un problema consultando la información en este momento. Intenta de nuevo en unos segundos.';\nreturn [{ json: { respuesta: String(r), intencion: j.intencion ?? 'consulta_general', bloqueado: false,\n  flags: [], codigo: n.codigo, session_id: n.session_id } }];"
      },
      "id": "84eb0d23-a254-5621-b014-ae54eb91d6c5",
      "name": "Unificar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sanitize",
        "text": "={{ $json.respuesta }}",
        "guardrails": {
          "pii": {
            "value": {
              "type": "selected",
              "entities": [
                "CREDIT_CARD",
                "CRYPTO",
                "IBAN_CODE",
                "IP_ADDRESS"
              ]
            }
          },
          "secretKeys": {
            "value": {
              "permissiveness": "balanced"
            }
          }
        }
      },
      "id": "6ecac702-0e1c-5938-8168-024c121a9dd8",
      "name": "Guardrails de salida",
      "type": "@n8n/n8n-nodes-langchain.guardrails",
      "typeVersion": 2,
      "position": [
        2080,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Guardrail propio: ninguna respuesta puede exponer códigos de OTROS estudiantes\nconst base = $('Unificar respuesta').first().json;\nconst g = $input.first().json ?? {};\nlet texto = String(g.guardrailsInput ?? base.respuesta);\nconst flags = [...(base.flags ?? [])];\nif (texto !== base.respuesta) flags.push('salida:pii');\nconst limpio = texto.replace(/\\bU\\d{8}\\b/gi, (m) => m.toUpperCase() === base.codigo ? m : 'U********');\nif (limpio !== texto) flags.push('salida:codigo_ajeno');\nconst fuentes = [...new Set((limpio.match(/https?:\\/\\/[^\\s)\\]>\"']+/g) ?? []).map(u => u.replace(/[.,;]+$/, '')))]\n  .slice(0, 5).map(u => ({ titulo: u.replace(/^https?:\\/\\/(www\\.)?/, '').split('/')[0], url: u }));\nconst n = $('Normalizar').first().json;\nreturn [{ json: { respuesta: limpio, intencion: base.intencion, bloqueado: base.bloqueado, fuentes, flags,\n  codigo: base.codigo, session_id: base.session_id, pregunta: n.mensaje, canal: n.canal,\n  latencia_ms: Date.now() - n.t0 } }];"
      },
      "id": "36aedcf8-980d-5fb0-bb13-3d2a6ccc9339",
      "name": "Validar salida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json; const n = $('Normalizar').first().json;\nreturn [{ json: { ...b, fuentes: [], pregunta: n.mensaje, canal: n.canal, latencia_ms: Date.now() - n.t0 } }];"
      },
      "id": "1257dde5-df9f-5b47-923d-d01255550c99",
      "name": "Preparar bloqueo",
