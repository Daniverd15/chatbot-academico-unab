      "parameters": {
        "inputText": "={{ $('Normalizar').item.json.mensaje }}",
        "categories": {
          "categories": [
            {
              "category": "asesoria_academica",
              "description": "Preguntas personales sobre SU situación académica: estado de matrícula, pagos, avance del plan, créditos, promedio/PGA, notas, estado académico, cursos que puede inscribir, cuándo se gradúa, proyección de semestres, alertas, requisitos pendientes, recomendaciones, información de un curso del plan y sus prerrequisitos."
            },
            {
              "category": "cursos_realizados",
              "description": "Qué cursos de COMPETENCIAS DIGITALES ha tomado o le faltan al estudiante, su avance en las rutas del CCD, su prueba diagnóstica o si ya puede obtener la insignia."
            },
            {
              "category": "calendario",
              "description": "Fechas y plazos: inscripciones, pruebas diagnósticas, inicio de cursos o clases, matrícula, cancelaciones, exámenes, vacacionales, grados."
            },
            {
              "category": "noticias",
              "description": "Noticias, novedades, nuevos cursos, convocatorias, eventos, becas o certificaciones recientes de la universidad."
            },
            {
              "category": "consulta_general",
              "description": "Preguntas generales sobre la universidad, el programa, el reglamento estudiantil, qué es la insignia o las rutas de competencias digitales, cómo funcionan los procesos, saludos y cualquier otra consulta."
            }
          ]
        },
        "options": {
          "fallback": "other",
          "systemPromptTemplate": "Clasifica el mensaje del estudiante universitario en UNA de las categorías: {categories}. Responde solo en formato JSON, sin explicaciones."
