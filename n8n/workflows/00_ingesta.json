    {
      "parameters": {
        "jsCode": "const h = $input.first().json.headers ?? {};\nconst b = $input.first().json.body ?? {};\nif ((h['x-api-key'] ?? '') !== $env.APP_API_KEY) throw new Error('API key inválida');\nif (!b.texto || String(b.texto).length < 50) throw new Error('Falta el campo texto (mín. 50 caracteres)');\nreturn [{ json: { titulo: b.titulo ?? 'Documento', url: b.url ?? '', fuente: b.fuente ?? 'Carga manual',\n  fecha: $now.toFormat('yyyy-MM-dd'), texto: String(b.texto) } }];"
      },
      "id": "914e10c1-b8e8-5a82-9dab-96b6ca86d94e",
