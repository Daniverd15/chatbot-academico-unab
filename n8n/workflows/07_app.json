    {
      "parameters": {
        "jsCode": "const h = $input.first().json.headers ?? {};\nconst b = $input.first().json.body ?? {};\nconst cal = Number(b.calificacion);\nreturn [{ json: { api_ok: (h['x-api-key'] ?? '') === $env.APP_API_KEY,\n  codigo: String(b.codigo ?? '').trim().toUpperCase(), pin: String(b.pin ?? ''),\n  log_id: Number(b.log_id), calificacion: cal,\n  valido: Number.isInteger(Number(b.log_id)) && Number.isInteger(cal) && cal >= 1 && cal <= 5 } }];"
      },
      "id": "8968409f-9b79-5514-a9da-5636b748d180",
      "name": "Validar feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
