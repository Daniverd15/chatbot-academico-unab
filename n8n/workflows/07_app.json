        -40,
        -240
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "app/login",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "7ffa13c9-9e56-5fb8-a0ce-b2e80f4decc5",
      "name": "Webhook login",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "unab-app-login"
    },
    {
      "parameters": {
        "jsCode": "const h = $input.first().json.headers ?? {};\nconst b = $input.first().json.body ?? {};\nreturn [{ json: { api_ok: (h['x-api-key'] ?? '') === $env.APP_API_KEY,\n  codigo: String(b.codigo ?? '').trim().toUpperCase(), pin: String(b.pin ?? '') } }];"
      },
      "id": "88afdae5-d527-5d04-b8cd-a5b8c734cf50",
      "name": "Validar login",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "7605bfa3-f913-4ab8-b86d-8a681d4176bf",
              "leftValue": "={{ $json.api_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c46c5155-e111-5f11-8e55-f1bcc0c72065",
      "name": "¿API key login?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MCP_URL.replace(/\\/mcp$/, '') }}/api/login",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ codigo: $json.codigo, pin: $json.pin }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "6cda1ef5-4f06-5839-b0c8-b2a3dc2ba31f",
      "name": "MCP login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        -60
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "credMcpBearer0001",
          "name": "MCP Bearer (chatbot-unab)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.ok === undefined ? { ok: false, mensaje: 'Servicio no disponible, intenta de nuevo.' } : $json) }}",
        "options": {}
      },
      "id": "a1e41551-ee68-5c0b-a116-a85682eb9688",
