{
  "id": "wfUnab07AppApi001",
  "name": "07 · API app móvil (login + tablero)",
  "nodes": [
    {
      "parameters": {
        "content": "## 07 · API de la app Android\n`POST /webhook/app/login` y `POST /webhook/app/dashboard` `{codigo, pin}` + `x-api-key`.\nn8n valida la API key y delega en el puente REST del servidor MCP.",
        "width": 540,
        "height": 160,
        "color": 4
      },
      "id": "0d2c157d-ead8-52f3-8bd4-7c3808e1811c",
      "name": "Nota 0",
