      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE chatbot.conversacion_log SET calificacion = $1 WHERE log_id = $2 AND codigo = $3 RETURNING log_id",
        "options": {
          "queryReplacement": "={{ [$('Validar feedback').item.json.calificacion, $('Validar feedback').item.json.log_id, $('Validar feedback').item.json.codigo] }}"
        }
